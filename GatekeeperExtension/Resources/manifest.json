{
  "manifest_version": 3,
  "name": "DurBi: Alışveriş Freni",
  "description": "Alışveriş sitelerinde ödeme yapmadan önce bir kez daha düşünmeni sağlar.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.trendyol.com/*",
    "*://*.amazon.com.tr/*",
    "*://*.amazon.com/*",
    "*://*.zara.com/*",
    "*://*.hm.com/*",
    "*://*.hepsiburada.com/*",
    "*://*.n11.com/*",
    "*://*.ciceksepeti.com/*",
    "*://*.boyner.com.tr/*",
    "*://*.lcw.com/*",
    "*://*.defacto.com.tr/*",
    "*://*.koton.com/*",
    "*://*.morhipo.com/*",
    "*://*.beymen.com/*",
    "*://*.vatanbilgisayar.com/*",
    "*://*.teknosa.com/*",
    "*://*.mediamarkt.com.tr/*",
    "*://*.flo.com.tr/*",
    "*://*.idefix.com/*",
    "*://*.dr.com.tr/*",
    "*://*.aliexpress.com/*",
    "*://*.shein.com/*",
    "*://*.asos.com/*",
    "*://*.zalando.com/*",
    "*://*.ebay.com/*",
    "*://*.nike.com/*",
    "*://*.ikea.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.trendyol.com/*",
        "*://*.amazon.com.tr/*",
        "*://*.amazon.com/*",
        "*://*.zara.com/*",
        "*://*.hm.com/*",
        "*://*.hepsiburada.com/*",
        "*://*.n11.com/*",
        "*://*.ciceksepeti.com/*",
        "*://*.boyner.com.tr/*",
        "*://*.lcw.com/*",
        "*://*.defacto.com.tr/*",
        "*://*.koton.com/*",
        "*://*.morhipo.com/*",
        "*://*.beymen.com/*",
        "*://*.vatanbilgisayar.com/*",
        "*://*.teknosa.com/*",
        "*://*.mediamarkt.com.tr/*",
        "*://*.flo.com.tr/*",
        "*://*.idefix.com/*",
        "*://*.dr.com.tr/*",
        "*://*.aliexpress.com/*",
        "*://*.shein.com/*",
        "*://*.asos.com/*",
        "*://*.zalando.com/*",
        "*://*.ebay.com/*",
        "*://*.nike.com/*",
        "*://*.ikea.com/*"
      ],
      "js": ["site-selectors.js", "overlay-styles.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
