    "Instagram'da Paylaş" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Share on Instagram" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Instagram'da Paylaş" } }
      }
    },
    "Belirlediğin gece saatlerinde hem uygulamada hem Safari uzantısında ekstra bir engel gösterilir." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "During the night hours you set, an extra barrier appears in both the app and the Safari extension." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Belirlediğin gece saatlerinde hem uygulamada hem Safari uzantısında ekstra bir engel gösterilir." } }
      }
    },
    "Safari Uzantısını Etkinleştir" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable the Safari Extension" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari Uzantısını Etkinleştir" } }
      }
    },
    "Trendyol, Amazon, Zara ve H&M ödeme sayfalarında otomatik uyarı için gerekir." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Needed for automatic warnings on Trendyol, Amazon, Zara and H&M checkout pages." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Trendyol, Amazon, Zara ve H&M ödeme sayfalarında otomatik uyarı için gerekir." } }
      }
    },
    "Zorluk" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Difficulty" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zorluk" } }
      }
    },
    "Trendyol, Amazon, Zara ve H&M gibi sitelerde ödeme ekranına geldiğinde otomatik uyarı gösterebilmemiz için uzantıyı Safari'de açman gerekiyor." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "For automatic warnings when you reach checkout on sites like Trendyol, Amazon, Zara and H&M, you need to turn the extension on in Safari." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Trendyol, Amazon, Zara ve H&M gibi sitelerde ödeme ekranına geldiğinde otomatik uyarı gösterebilmemiz için uzantıyı Safari'de açman gerekiyor." } }
      }
    },
    "Aşağıdaki butona bas, Ayarlar uygulaması açılsın" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the button below to open the Settings app" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aşağıdaki butona bas, Ayarlar uygulaması açılsın" } }
      }
    },
    "Safari → Uzantılar → \"Bekle\" uzantısını bul" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Safari → Extensions → find the \"Bekle\" extension" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari → Uzantılar → \"Bekle\" uzantısını bul" } }
      }
    },
    "Uzantıyı aç ve tüm web siteleri için izin ver" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn the extension on and allow it for all websites" } },
