    },
    "Geçmiş performans, gelecek için garanti değildir. Uzun vadeli ortalamalara dayalı kaba bir tahmindir." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Past performance is not a guarantee of future results. A rough estimate based on long-run averages." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geçmiş performans, gelecek için garanti değildir. Uzun vadeli ortalamalara dayalı kaba bir tahmindir." } }
