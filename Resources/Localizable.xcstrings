    "Ayarları Aç" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayarları Aç" } }
      }
    },
    "Not: Uzantı sadece ödeme sayfasına geldiğinde devreye girer; gezinme geçmişini takip etmez ya da veri toplamaz, tüm veriler sadece cihazında kalır." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Note: the extension only activates on checkout pages; it doesn't track your browsing history or collect data — everything stays on your device." } },
