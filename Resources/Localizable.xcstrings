      }
    },
    "Gece geç saatte alışveriş genelde anlık bir dürtüdür. Devam etmeden önce bir adım daha at." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Late-night shopping is usually an impulse. Take one more step before continuing." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gece geç saatte alışveriş genelde anlık bir dürtüdür. Devam etmeden önce bir adım daha at." } }
      }
    },
    "15 saniye boyunca parmağını bu daireden çekme" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your finger on this circle for 15 seconds" } },
